    "failed.keep" : {
      "comment" : "Failure screen when a run broke off. %@ = the error message; the second paragraph refers to the button common.continue.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDokončené úpravy zůstaly uložené. Kliknutím na „Pokračovat“ navážete tam, kde jste skončili."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDie bisherigen Bearbeitungen sind gespeichert. Mit „Fortsetzen“ machst du dort weiter, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nYour edits so far are saved. Select “Resume” to pick up where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nSe han guardado los cambios hechos. Pulsa «Reanudar» para seguir donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLes retouches terminées sont conservées. Cliquez sur « Reprendre » pour reprendre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nEdit yang sudah selesai tetap tersimpan. Pilih “Lanjutkan” untuk melanjutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nLe modifiche completate sono salvate. Seleziona «Riprendi» per riprendere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n完了した編集は保存されています。「再開」で再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n완료된 보정은 저장되어 있습니다. “계속”를 눌러 이어서 작업하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nFerdige redigeringer er lagret. Velg «Fortsett» for å fortsette der du slapp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nAfgeronde bewerkingen zijn opgeslagen. Klik op ‘Hervat’ om verder te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nUkończone zmiany zostały zapisane. Kliknij „Wznów”, aby wznowić obróbkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nAs edições concluídas foram salvas. Clique em “Retomar” para retomar de onde parou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nГотовые правки сохранены. Нажмите «Продолжить», чтобы продолжить обработку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nDet som redan är klart har sparats. Välj ”Fortsätt” för att fortsätta där du slutade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nบันทึกส่วนที่ทำเสร็จแล้ว กด “ทำต่อ” เพื่อทำต่อจากจุดเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nTamamlanan düzenlemeler kaydedildi. Kaldığınız yerden sürdürmek için “Devam Et” seçeneğine tıklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nCác chỉnh sửa đã xong vẫn được lưu. Chọn “Tiếp tục” để làm tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n已经做完的部分都在，可以点“继续”接着做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n已完成的修圖都已保留。按「繼續」接著修。"
          }
        }
      }
    },
