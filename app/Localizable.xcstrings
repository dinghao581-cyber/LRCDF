        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat terhubung ke server pembaruan. Coba lagi nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile contattare il server degli aggiornamenti. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートサーバに接続できませんでした。しばらくしてからお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 서버에 연결하지 못했습니다. 나중에 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
