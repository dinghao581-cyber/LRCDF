    "level.auto.note" : {
      "comment" : "Line under the level row when 'automatic' is chosen.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro každý obličej vybere úroveň, která pleť co nejvíc vyhladí a zachová přirozený vzhled (doporučeno)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt für jedes Gesicht eine Stufe, damit die Haut möglichst ebenmäßig und trotzdem natürlich wirkt (empfohlen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a level for each face for the cleanest result that still looks natural (recommended)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un nivel para cada rostro y lo retoca sin perder naturalidad (recomendado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit un niveau pour chaque visage, pour une peau nette qui reste naturelle (recommandé)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih tingkat untuk tiap wajah agar kulit tampak lebih bersih dan tetap alami (disarankan)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie un livello per ogni viso, per una pelle più uniforme che resti naturale (consigliato)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顔ごとに強さを選び、自然さを保ちながらきれいに整えます（おすすめ）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼굴마다 강도를 골라 자연스러움을 유지하면서 깔끔하게 보정합니다(권장)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger et nivå for hvert ansikt, slik at huden blir jevnest mulig og fortsatt ser naturlig ut (anbefalt)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest een niveau per gezicht voor een zo egaal mogelijk, natuurlijk resultaat (aanbevolen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobiera poziom do każdej twarzy, by maksymalnie wyrównać cerę i zachować naturalny wygląd (zalecane)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe um nível para cada rosto e suaviza a pele sem perder a naturalidade (recomendado)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подбирает уровень для каждого лица, чтобы кожа выглядела чище и сохраняла естественный вид (рекомендуется)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljer en nivå för varje ansikte så att huden blir så jämn som möjligt och ändå ser naturlig ut (rekommenderas)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระดับให้แต่ละใบหน้า เพื่อให้ผิวดูเรียบเนียนที่สุดโดยยังดูเป็นธรรมชาติ (แนะนำ)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yüz için doğal görünümü koruyarak cildi olabildiğince pürüzsüz gösteren bir düzey seçer (önerilir)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn mức riêng cho từng khuôn mặt để da trông sạch hơn mà vẫn tự nhiên (khuyên dùng)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每张脸各选一档：修不过头的前提下尽量干净（推荐）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
