    "rights.breakReminder" : {
      "comment" : "Checkbox at the end of the rights card.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomenout přestávku po 1,5 hodině práce bez přerušení"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach 1,5 Stunden Arbeit ohne Pause an eine Pause erinnern"
          }
        },
        "en" : {
          "stringUnit" : {
