      }
    },
    "paused.title" : {
      "comment" : "Title of the card while a run is paused.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停"
          }
        }
      }
    },
    "person.follow" : {
      "comment" : "Under a person's face: they get the general level. One short word.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随"
          }
        }
      }
    },
    "person.help" : {
      "comment" : "Explanation of the per-person faces (opens from the ? button). Mentions the five choices by name: keep them the same as person.follow, person.light, level.natural, level.refined, person.off.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个人可以单独设置：点头像，在 跟随、轻、自然、精致、不修 之间切换。跟随 = 用上面的整体档位。男士和小孩默认是 轻；你改过的人，下次会记住。"
          }
        }
      }
    },
    "person.light" : {
      "comment" : "Under a person's face: light retouching. One short word.",
      "extractionState" : "manual",
