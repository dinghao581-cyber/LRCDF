    "shape.light" : {
      "comment" : "Chip: evens out side light on the face. Short.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rovnoměrné osvětlení"
          }
        },
        "de" : {
          "stringUnit" : {
