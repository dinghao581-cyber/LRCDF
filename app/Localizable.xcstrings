        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите или сведите пальцы для масштабирования · Перетаскивайте увеличенное фото · Двойной щелчок увеличивает или сбрасывает масштаб"
