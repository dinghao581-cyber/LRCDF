    "undo.done" : {
      "comment" : "Notice after undoing a run that only changed colour.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úpravy byly vráceny. Fotky mají stejnou podobu jako před úpravou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitung rückgängig gemacht. Die Fotos sind wieder im ursprünglichen Zustand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edits undone. The photos are back to how they were before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edición deshecha. Las fotos han vuelto a su estado anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retouches annulées. Les photos ont retrouvé leur état d’origine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit diurungkan. Foto kembali seperti sebelum diedit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritocco annullato. Le foto sono tornate com’erano prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集を取り消し、写真を編集前の状態に戻しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보정을 취소했습니다. 사진이 보정 전 상태로 돌아갔습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringen er angret. Bildene er tilbake slik de var før."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerkingen ongedaan gemaakt. De foto’s zijn weer zoals vóór de bewerking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cofnięto obróbkę. Zdjęcia wróciły do stanu sprzed edycji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edições desfeitas. As fotos voltaram ao estado anterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правки отменены. Фото возвращены к состоянию до обработки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringen har ångrats. Fotona är tillbaka som de var före redigeringen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลิกแต่งรูปแล้ว รูปกลับเป็นเหมือนก่อนแต่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemeler geri alındı. Fotoğraflar düzenleme öncesi hâline döndü."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã hoàn tác. Ảnh đã trở lại như trước khi chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已撤销，照片回到修图前的样子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已復原。相片已回到修圖前的樣子。"
          }
        }
      }
    },
    "undo.doneWithRejects" : {
      "comment" : "Notice after undoing a run that made retouched pictures. %lld = number of pictures. Names a Lightroom menu path (Photo → Delete Rejected Photos): use Lightroom's menu names in the target language.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úpravy byly vráceny a barvy obnoveny. Počet retušovaných kopií označených jako zamítnuté: %lld. V Lightroomu je smažete najednou přes Photo → Delete Rejected Photos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitung rückgängig gemacht, Farben wiederhergestellt. Als abgelehnt markierte retuschierte Kopien: %lld. Über Foto → Abgelehnte Fotos löschen kannst du sie in Lightroom auf einmal entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edits undone and color restored. Retouched copies marked as rejected: %lld. To remove them all in Lightroom, choose Photo → Delete Rejected Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edición deshecha y color restaurado. Copias retocadas marcadas como rechazadas: %lld. Para eliminarlas todas en Lightroom, ve a Foto → Eliminar fotos rechazadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retouches annulées et couleurs rétablies. Copies retouchées marquées comme rejetées : %lld. Pour les supprimer en une fois dans Lightroom, choisissez Photo → Supprimer les photos rejetées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit diurungkan dan warna dikembalikan. Jumlah salinan yang diretus dan ditandai ditolak: %lld. Untuk menghapus semuanya sekaligus di Lightroom, pilih Photo → Delete Rejected Photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritocco annullato e colori ripristinati. Copie ritoccate contrassegnate come rifiutate: %lld. Per eliminarle tutte in Lightroom, scegli Foto → Elimina foto rifiutate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集を取り消し、色を元に戻しました。除外フラグを付けたレタッチ済みコピー：%lld 枚。Lightroom の「写真 → 除外された写真を削除」でまとめて削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보정을 취소하고 색상을 복원했습니다. 제외로 표시한 보정본: %lld장. Lightroom에서 사진 → 제외된 사진 삭제를 선택해 한 번에 정리할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringen er angret og fargene gjenopprettet. Retusjerte kopier merket som avvist: %lld. Fjern alle samtidig i Lightroom via Bilde → Slett avviste bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerkingen ongedaan gemaakt en kleuren hersteld. Geretoucheerde kopieën gemarkeerd als afgewezen: %lld. Verwijder ze in één keer via Foto → Afgewezen foto’s verwijderen in Lightroom."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cofnięto obróbkę i przywrócono kolory. Liczba wyretuszowanych kopii oznaczonych jako odrzucone: %lld. Aby usunąć je za jednym razem w Lightroom, wybierz Zdjęcie → Usuń odrzucone zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edições desfeitas e cores restauradas. Cópias retocadas marcadas como rejeitadas: %lld. Para removê-las de uma vez no Lightroom, escolha Foto → Excluir fotos rejeitadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правки отменены, цвета восстановлены. Число обработанных копий с отметкой об отклонении: %lld. Чтобы удалить их все в Lightroom, выберите «Фото → Удалить отклоненные фотографии»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringen har ångrats och färgerna återställts. Retuscherade kopior markerade som avvisade: %lld. Ta bort alla samtidigt i Lightroom via Foto → Ta bort avvisade foton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลิกแต่งรูปและคืนสีเดิมแล้ว จำนวนสำเนาที่รีทัชและทำเครื่องหมายว่าปฏิเสธ: %lld หากใช้ Lightroom ภาษาอังกฤษ ให้ลบพร้อมกันที่ Photo → Delete Rejected Photos"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemeler geri alındı ve renkler eski hâline döndü. Reddedildi olarak işaretlenen rötuşlu kopya sayısı: %lld. Tümünü Lightroom’da tek seferde kaldırmak için Photo → Delete Rejected Photos yolunu izleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã hoàn tác và khôi phục màu. Số bản đã chỉnh được đánh dấu loại: %lld. Để xóa tất cả cùng lúc trong Lightroom, chọn Photo → Delete Rejected Photos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已撤销。调色已还原，%lld 张美颜成片被标记为“排除”，在 Lightroom 里用 照片 → 删除排除的照片 可以一次清掉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已復原並還原調色。標為排除的美顏成品數：%lld。可在 Lightroom 選擇「相片 → 刪除排除的相片」一次清除。"
          }
        }
      }
    },
    "undo.failed" : {
      "comment" : "Notice when undoing did not work. %@ = the error message.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úpravy se nepodařilo vrátit: %@"
          }
