        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีเวอร์ชันใหม่ แต่ LRCDF เวอร์ชันนี้เก่าเกินกว่าจะอัปเดตอัตโนมัติได้ โปรดไปที่หน้าดาวน์โหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni sürüm var, ancak LRCDF’nin bu sürümü otomatik güncellenemeyecek kadar eski. Yeni sürümü indirme sayfasından alın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có phiên bản mới, nhưng bản LRCDF này đã quá cũ để tự động cập nhật. Hãy tải phiên bản mới từ trang tải xuống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有新版本，但这一版 LRCDF 太旧，不能自动更新，请到下载页获取"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有新版本，但目前的 LRCDF 版本太舊，無法自動更新。請到下載頁面下載新版本。"
          }
        }
      }
    },
    "update.unreachable" : {
      "comment" : "Line after a manual check when the server could not be reached or its answer could not be trusted.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodařilo se připojit k aktualizačnímu serveru. Zkuste to později."
          }
