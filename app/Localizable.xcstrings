    "update.broken" : {
      "comment" : "Line when a downloaded update failed its integrity check.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažená aktualizace nebyla úplná a byla zahozena. Příště se stáhne znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heruntergeladene Update war unvollständig und wurde verworfen. Es wird beim nächsten Mal erneut heruntergeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The update download was incomplete and has been discarded. It will download again next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización descargada estaba incompleta y se ha descartado. Se volverá a descargar la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour téléchargée était incomplète et a été écartée. Elle sera téléchargée à nouveau la prochaine fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan yang diunduh tidak lengkap, jadi telah dibuang. Aplikasi akan mengunduhnya ulang lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aggiornamento scaricato era incompleto ed è stato scartato. Verrà scaricato di nuovo al prossimo tentativo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたアップデートが不完全なため、破棄しました。次回ダウンロードし直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 업데이트가 완전하지 않아 삭제했습니다. 다음에 다시 다운로드합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den nedlastede oppdateringen var ufullstendig og ble forkastet. Den lastes ned på nytt neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedownloade update was onvolledig en is verwijderd. De volgende keer wordt de update opnieuw gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobrana aktualizacja była niekompletna, więc została odrzucona. Następnym razem aplikacja pobierze ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização baixada estava incompleta e foi descartada. Ela será baixada novamente na próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачанное обновление неполное и было удалено. В следующий раз приложение скачает его заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hämtade uppdateringen var ofullständig och har kasserats. Den hämtas på nytt nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์อัปเดตที่ดาวน์โหลดมาไม่สมบูรณ์และถูกทิ้งแล้ว ครั้งหน้าจะดาวน์โหลดใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen güncelleme eksik olduğu için kullanılmadı. Bir dahaki sefer yeniden indirilecek."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản cập nhật tải về chưa đầy đủ nên đã bị loại bỏ. Lần sau ứng dụng sẽ tải lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载的更新不完整，已放弃。下次会重新下载"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載的更新不完整，已捨棄。下次會重新下載。"
          }
        }
      }
    },
    "update.checkNow" : {
      "comment" : "Button in Settings and item in the app menu.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
