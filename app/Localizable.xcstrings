    "rights.pay.body" : {
      "comment" : "Rights card, text 1.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "雇员有权获得至少法定最低工资，以及按所适用的行业裁定（award）或协议应得的加班、周末和公共假日待遇。如果“无薪”做的是真正的工作，而不是很短的、合理的评估，通常是违法的。"
          }
        }
