    "rights.help.fwo.how" : {
      "comment" : "What that body offers and its phone number.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatná konzultace s možností tlumočení. Telefon 13 13 94"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Beratung mit Dolmetschdienst. Rufen Sie 13 13 94 an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free advice with interpreting available. Call 13 13 94"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asesoramiento gratuito con servicio de interpretación. Llama al 13 13 94"
