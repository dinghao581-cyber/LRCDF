    "loading.note" : {
      "comment" : "Line under the loading title.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asi 20 sekund. Fotky s hotovým náhledem se příště otevřou hned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 20 Sekunden. Fotos mit fertiger Vorschau öffnen sich beim nächsten Mal sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About 20 seconds. Once previewed, photos open right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos 20 segundos. Las fotos ya previsualizadas se abrirán al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ 20 secondes. Les photos déjà prévisualisées s’ouvriront tout de suite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekitar 20 detik. Foto yang sudah dipratinjau akan langsung terbuka lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa 20 secondi. Le foto già viste in anteprima si apriranno subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約20秒。プレビュー済みの写真は次回すぐに開けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 20초가 걸려요. 미리 본 사진은 다음에 바로 열려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omtrent 20 sekunder. Bilder du har forhåndsvist åpnes med en gang neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongeveer 20 seconden. Foto’s met een voorvertoning openen de volgende keer meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Około 20 sekund. Zdjęcia z gotowym podglądem otworzą się od razu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de 20 segundos. Fotos com prévia abrirão na hora da próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Около 20 секунд. Уже просмотренные фото откроются сразу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cirka 20 sekunder. Förhandsvisade foton öppnas direkt nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เวลาราว 20 วินาที ภาพที่เคยดูตัวอย่างจะเปิดได้ทันทีในครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık 20 saniye. Önizlemesi hazır fotoğraflar bir dahaki sefere hemen açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoảng 20 giây. Ảnh đã xem trước sẽ mở ngay vào lần sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大约 20 秒，看过的照片下次直接打开"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約 20 秒，預覽過的照片下次可直接開啟"
          }
        }
      }
