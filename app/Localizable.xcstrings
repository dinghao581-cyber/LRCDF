        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplázate o pellizca para ampliar · Arrastra al ampliar · Haz doble clic para ampliar o restablecer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites défiler ou pincez pour zoomer · Faites glisser la photo agrandie · Double-cliquez pour zoomer ou réinitialiser"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulir atau cubit untuk memperbesar atau memperkecil · Seret foto saat diperbesar · Klik dua kali untuk memperbesar atau kembali ke ukuran awal"
