    "update.tooNew" : {
      "comment" : "Line when the update feed is of a newer kind than this app understands.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je dostupná nová verze, ale tato verze LRCDF je příliš stará na automatickou aktualizaci. Novou verzi získáte na stránce ke stažení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Version ist verfügbar. Deine LRCDF-Version ist zu alt für automatische Updates. Lade die neue Version von der Downloadseite herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new version is available. This version of LRCDF is too old to update automatically. Get the latest version from the download page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una nueva versión. Esta versión de LRCDF es demasiado antigua para actualizarse automáticamente. Descarga la nueva versión desde la página de descarga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle version est disponible. Votre version de LRCDF est trop ancienne pour se mettre à jour automatiquement. Récupérez la nouvelle version sur la page de téléchargement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versi baru tersedia, tetapi versi LRCDF ini terlalu lama untuk diperbarui secara otomatis. Dapatkan versi baru dari halaman unduhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È disponibile una nuova versione. Questa versione di LRCDF è troppo vecchia per aggiornarsi automaticamente. Scarica la nuova versione dalla pagina di download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいバージョンがあります。お使いの LRCDF はバージョンが古いため、自動でアップデートできません。ダウンロードページから入手してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 버전이 있지만 현재 LRCDF 버전이 너무 오래되어 자동으로 업데이트할 수 없습니다. 다운로드 페이지에서 받으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny versjon er tilgjengelig. Denne versjonen av LRCDF er for gammel til å oppdateres automatisk. Hent den nye versjonen fra nedlastingssiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een nieuwe versie. Deze versie van LRCDF is te oud om automatisch bij te werken. Haal de nieuwe versie op via de downloadpagina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest nowa wersja, ale ta wersja LRCDF jest za stara, by zaktualizować się automatycznie. Pobierz nową wersję ze strony pobierania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há uma nova versão. Esta versão do LRCDF é antiga demais para ser atualizada automaticamente. Baixe a nova versão na página de download."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вышла новая версия, но эта версия LRCDF слишком стара для автоматического обновления. Скачайте новую версию со страницы скачивания."
          }
        },
        "sv" : {
          "stringUnit" : {
