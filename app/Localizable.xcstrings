        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스크롤하거나 두 손가락으로 확대·축소 · 확대한 사진을 드래그해 이동 · 더블 클릭으로 확대 또는 원래대로"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rull eller knip med to fingre for å zoome · Dra bildet når du har zoomet inn · Dobbeltklikk for å zoome eller tilbakestille"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrol of knijp om te zoomen · Versleep de ingezoomde foto · Dubbelklik om te zoomen of te herstellen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przewiń lub zsuń palce, aby zmienić powiększenie · Przeciągnij powiększone zdjęcie · Kliknij dwukrotnie, aby powiększyć lub zresetować"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Role ou faça pinça para ampliar · Arraste a foto ampliada · Clique duas vezes para ampliar ou redefinir"
