    "rights.help.afp.how" : {
      "comment" : "What to report there, and phone numbers.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlášení nucené práce a obchodování s lidmi. Telefon 131 237. V naléhavém případě volejte 000"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie Zwangsarbeit oder Menschenhandel unter 131 237. Im Notfall wählen Sie 000"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report forced labour or human trafficking. Call 131 237. In an emergency, call 000"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denuncia el trabajo forzoso o la trata de personas en el 131 237. En caso de emergencia, llama al 000"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalez le travail forcé ou la traite des personnes au 131 237. En cas d’urgence, appelez le 000"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporkan kerja paksa dan perdagangan orang. Telepon 131 237. Dalam keadaan darurat, hubungi 000"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segnala lavoro forzato o tratta di persone al 131 237. In caso di emergenza, chiama il 000"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制労働や人身取引の通報先：131 237。緊急時は 000"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강제 노동이나 인신매매 신고는 131 237. 긴급 상황에서는 000에 전화하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld fra om tvangsarbeid eller menneskehandel på 131 237. Ring 000 i en nødssituasjon"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld dwangarbeid of mensenhandel via 131 237. Bel bij nood 000"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoś pracę przymusową lub handel ludźmi pod numerem 131 237. W nagłym wypadku zadzwoń pod 000"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denuncie trabalho forçado ou tráfico de pessoas pelo 131 237. Em caso de emergência, ligue para 000"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщите о принудительном труде или торговле людьми по номеру 131 237. В экстренной ситуации звоните 000"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmäl tvångsarbete eller människohandel på 131 237. Ring 000 i en nödsituation"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งเหตุแรงงานบังคับหรือการค้ามนุษย์ โทร 131 237 หากมีเหตุฉุกเฉิน โทร 000"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorla çalıştırma ve insan ticareti ihbarı. Telefon 131 237. Acil durumlarda 000’ı arayın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình báo lao động cưỡng bức và buôn người. Gọi 131 237. Trường hợp khẩn cấp, gọi 000"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强迫劳动、人口贩运举报。电话 131 237；紧急情况拨 000"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舉報強迫勞動或人口販運。請撥打 131 237。緊急情況請撥打 000"
          }
        }
      }
    },
