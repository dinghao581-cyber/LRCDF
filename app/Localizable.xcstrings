            "value" : "署名与作品"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名與作品"
          }
        }
      }
    },
    "rights.disclaimer" : {
      "comment" : "First paragraph of the rights card.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jde o obecné informace vycházející z federálního práva Austrálie a předpisů Teritoria hlavního města Austrálie (Canberra, ACT). Nejde o právní radu. Pokud pracujete jinde, místní zákony se mohou lišit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese allgemeinen Informationen stützen sich auf australisches Bundesrecht und das Recht des Australian Capital Territory (ACT, Canberra). Sie sind keine Rechtsberatung. Wenn Sie anderswo arbeiten, können andere Gesetze gelten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This general information is based on Australian federal law and the law of the Australian Capital Territory (ACT, Canberra). It is not legal advice. If you work elsewhere, local laws may differ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta información general se basa en la legislación federal australiana y en la del Territorio de la Capital Australiana (ACT, Canberra). No constituye asesoramiento jurídico. Si trabajas en otro lugar, la legislación local puede ser distinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces informations générales reposent sur le droit fédéral australien et celui du Territoire de la capitale australienne (ACT, Canberra). Elles ne constituent pas un avis juridique. Si vous travaillez ailleurs, le droit local peut être différent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah informasi umum berdasarkan hukum federal Australia dan aturan Wilayah Ibu Kota Australia (Canberra, ACT), bukan nasihat hukum. Jika Anda bekerja di tempat lain, hukum setempat mungkin berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste informazioni generali si basano sulla legislazione federale australiana e su quella del Territorio della Capitale Australiana (ACT, Canberra). Non costituiscono una consulenza legale. Se lavori altrove, le leggi locali possono essere diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下はオーストラリア連邦法およびオーストラリア首都特別地域（ACT、キャンベラ）の法令に基づく一般情報です。法律相談に代わるものではありません。ほかの地域で働いている場合は、現地の法律が異なることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 내용은 호주 연방법과 호주 수도 준주(ACT, 캔버라) 법에 따른 일반 정보이며, 법률 자문이 아닙니다. 다른 지역에서 일하는 경우 현지 법이 다를 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne informasjonen bygger på føderal australsk lov og reglene i Australian Capital Territory (ACT, Canberra). Den er generell og er ikke juridisk rådgivning. Arbeider du andre steder, kan andre lover gjelde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze algemene informatie is gebaseerd op de Australische federale wetgeving en de wetgeving van het Australisch Hoofdstedelijk Territorium (ACT, Canberra). Dit is geen juridisch advies. Als je ergens anders werkt, kunnen daar andere wetten gelden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ogólne informacje oparte na australijskim prawie federalnym i przepisach Australijskiego Terytorium Stołecznego (ACT, Canberra). Nie stanowią porady prawnej. Jeśli pracujesz gdzie indziej, mogą obowiązywać inne przepisy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas informações gerais se baseiam nas leis federais da Austrália e nas do Território da Capital Australiana (ACT, Camberra). Não constituem orientação jurídica. Se você trabalha em outro lugar, as leis locais podem ser diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это общая информация, основанная на федеральном законодательстве Австралии и законодательстве Австралийской столичной территории (ACT, Канберра). Она не является юридической консультацией. Если вы работаете в другом месте, там могут действовать другие законы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här allmänna informationen bygger på australisk federal lagstiftning och reglerna i Australian Capital Territory (ACT, Canberra). Den är inte juridisk rådgivning. Om du arbetar någon annanstans kan andra regler gälla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลทั่วไปนี้อ้างอิงกฎหมายรัฐบาลกลางของออสเตรเลียและกฎหมายเขตเมืองหลวงออสเตรเลีย (ACT, แคนเบอร์รา) ไม่ใช่คำแนะนำทางกฎหมาย หากคุณทำงานในพื้นที่อื่น กฎหมายท้องถิ่นอาจแตกต่างกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu metin genel bilgilendirme amaçlıdır ve hukuki tavsiye niteliği taşımaz. Avustralya federal yasalarına ve Avustralya Başkent Bölgesi (Canberra, ACT) düzenlemelerine dayanır. Başka bir yerde çalışıyorsanız yerel yasalar farklı olabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là thông tin chung dựa trên luật liên bang Úc và các quy định của Lãnh thổ Thủ đô Úc (Canberra, ACT), không phải tư vấn pháp lý. Nếu bạn làm việc ở nơi khác, luật địa phương có thể khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下为一般性信息，不是法律意见，依据澳大利亚联邦法律和首都领地（堪培拉，ACT）的规定。如果你在其他地方工作，当地法律可能不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下為一般資訊，依據澳洲聯邦及澳洲首都領地（ACT，坎培拉）的法規。這不是法律意見。若你在其他地區工作，當地法律可能不同。"
          }
        }
      }
    },
