    "paused.note" : {
      "comment" : "Text of the paused card. %1 = photos done, %2 = photos left.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotovo: %1$lld. Zbývá: %2$lld. Aplikaci můžete zavřít a v úpravách pokračovat při příštím spuštění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig: %1$lld. Offen: %2$lld. Du kannst die App schließen und beim nächsten Öffnen weitermachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done: %1$lld. Left to edit: %2$lld. You can close the app and pick up where you left off next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completadas: %1$lld. Pendientes: %2$lld. Puedes cerrar la app y continuar la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminées : %1$lld. Restantes : %2$lld. Vous pouvez fermer l’app et reprendre à la prochaine ouverture."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesai: %1$lld. Tersisa: %2$lld. Anda bisa menutup aplikasi dan melanjutkan saat membukanya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completate: %1$lld. Rimanenti: %2$lld. Puoi chiudere l’app e riprendere alla prossima apertura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了 %1$lld 枚、残り %2$lld 枚。アプリを閉じても、次に開いたときに続きから再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료 %1$lld장, 남음 %2$lld장. 앱을 닫아도 다음에 열어서 이어서 보정할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferdige: %1$lld. Gjenstår: %2$lld. Du kan lukke appen og fortsette neste gang du åpner den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaar: %1$lld. Resterend: %2$lld. Je kunt de app sluiten en de volgende keer verdergaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończono: %1$lld. Pozostało: %2$lld. Możesz zamknąć aplikację i dokończyć edycję przy następnym uruchomieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concluídas: %1$lld. Pendentes: %2$lld. Você pode fechar o app e continuar quando abri-lo novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово: %1$lld. Осталось: %2$lld. Можно закрыть приложение и продолжить при следующем запуске."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klara: %1$lld. Kvar: %2$lld. Du kan stänga appen och fortsätta nästa gång du öppnar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสร็จแล้ว %1$lld ภาพ เหลือ %2$lld ภาพ ปิดแอปแล้วเปิดมาทำต่อภายหลังได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamlanan: %1$lld. Kalan: %2$lld. Uygulamayı kapatıp bir dahaki açışınızda kaldığınız yerden devam edebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xong: %1$lld. Còn lại: %2$lld. Bạn có thể đóng ứng dụng và chỉnh tiếp vào lần mở sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成 %1$lld 张，还剩 %2$lld 张。关掉程序也没关系，下次打开可以接着修。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成 %1$lld 張，還剩 %2$lld 張。可以關閉 App，下次開啟時再繼續。"
          }
        }
      }
    },
