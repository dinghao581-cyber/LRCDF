    "denoise.noisyNote" : {
      "comment" : "Note under the denoise switch when the photos were shot at high ISO. %lld = the ISO value.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyto fotky mají vysoké ISO (%lld). Tuto volbu doporučujeme zapnout. Každá fotka zabere asi o 10 sekund déle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Fotos wurden mit hohem ISO-Wert aufgenommen (%lld). Aktiviere die Option am besten. Die Bearbeitung dauert etwa 10 Sekunden länger je Foto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These photos were shot at high ISO (%lld). Try turning this on. It adds about 10 seconds per photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos se tomaron con un ISO alto (%lld). Activa esta opción. Añade unos 10 segundos por foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces photos ont été prises à une sensibilité ISO élevée (%lld). Activez cette option. Comptez environ 10 secondes de plus par photo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dalam kelompok ini diambil dengan ISO tinggi (%lld). Sebaiknya aktifkan opsi ini. Waktunya bertambah sekitar 10 detik per foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste foto sono state scattate a ISO elevati (%lld). Ti consigliamo di attivare l’opzione. Richiede circa 10 secondi in più per foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真は高感度（ISO %lld）で撮影されています。オンがおすすめです。1 枚につき約 10 秒長くかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진들은 높은 감도(ISO %lld)로 촬영했어요. 켜는 것을 권장해요. 사진당 약 10초가 더 걸려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse bildene er tatt med høy ISO (%lld). Vi anbefaler å slå på funksjonen. Det tar omtrent 10 sekunder ekstra per bilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze foto's zijn gemaakt met een hoge ISO-waarde (%lld). Schakel dit bij voorkeur in. Het kost ongeveer 10 seconden extra per foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te zdjęcia zrobiono przy wysokim ISO (%lld). Zalecamy włączenie tej opcji. Zajmie to ok. 10 sekund dłużej na każde zdjęcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fotos foram feitas com ISO alto (%lld). Recomendamos ativar. Leva cerca de 10 segundos a mais por foto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти фото сняты с высокой светочувствительностью (ISO %lld). Рекомендуем включить. На каждое фото уйдёт примерно на 10 секунд больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotona är tagna med högt ISO (%lld). Vi rekommenderar att du slår på funktionen. Det tar cirka 10 sekunder extra per foto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาพชุดนี้ถ่ายด้วย ISO สูง (%lld) แนะนำให้เปิด ใช้เวลาเพิ่มราว 10 วินาทีต่อภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu fotoğraflar yüksek ISO (%lld) ile çekildi. Bu ayarı açmanız önerilir. Fotoğraf başına yaklaşık 10 saniye ekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loạt ảnh này được chụp ở ISO cao (%lld). Nên bật tùy chọn này. Mỗi ảnh mất thêm khoảng 10 giây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这组照片感光度较高（ISO %lld），建议打开。每张多花约 10 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這組照片的感光度較高（ISO %lld），建議開啟。每張約多花 10 秒。"
          }
        }
      }
    },
