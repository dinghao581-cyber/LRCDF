    "update.autoNote" : {
      "comment" : "Explanation under the switch in Settings. Must stay true to the privacy policy: translate faithfully.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks once when LRCDF opens, then about once a day. Only downloads a small public file with the version number; nothing about you, your photos or your catalog is sent. With it off, LRCDF itself makes no connections (the bundled Google MediaPipe library may still send usage statistics, no photos; see the privacy policy)."
          }
        },
        "de" : {
          "stringUnit" : {
