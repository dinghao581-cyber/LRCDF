    "rights.help.fwc.how" : {
      "comment" : "What that body handles.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podání ve věcech nespravedlivého propuštění, šikany a dalších problémů"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anträge wegen ungerechtfertigter Kündigung, Mobbing am Arbeitsplatz und ähnlichen Fällen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claims about unfair dismissal, workplace bullying and more"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reclamaciones por despido injustificado, acoso moral en el trabajo y otros asuntos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandes liées à un licenciement abusif, à de l’intimidation au travail ou à des faits similaires"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengajuan terkait pemecatan tidak adil, perundungan, dan masalah lainnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricorsi per licenziamento ingiusto, vessazioni sul lavoro e casi simili"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不当解雇や職場でのいじめなどに関する申立て"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부당해고, 직장 내 괴롭힘 등에 관한 신청"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saker om usaklig oppsigelse, mobbing på jobben og lignende"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzoeken over onredelijk ontslag, pesten op het werk en andere kwesties"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wnioski w sprawie niesprawiedliwego zwolnienia, nękania w pracy i podobnych spraw"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedidos sobre demissão injusta, assédio moral no trabalho e outros casos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заявления по поводу несправедливого увольнения, травли на работе и других нарушений"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansökningar vid oskälig uppsägning, mobbning på jobbet med mera"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยื่นคำร้องเรื่องการเลิกจ้างไม่เป็นธรรม การกลั่นแกล้งในที่ทำงาน และเรื่องอื่น ๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haksız işten çıkarma, zorbalık ve benzeri konularda başvuru"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nộp đơn về sa thải bất công, bắt nạt và các vấn đề khác"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不公平解雇、欺凌等申请"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不公平解僱、職場欺凌等申請"
          }
        }
      }
    },
