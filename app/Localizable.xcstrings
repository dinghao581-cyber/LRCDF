    "zoom.help" : {
      "comment" : "Hover help of the zoom control: the gestures.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přibližujte kolečkem nebo dvěma prsty · Přiblíženou fotku posouvejte tažením · Dvojklikem přibližte nebo obnovte velikost"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen scrollen oder zwei Finger bewegen · Vergrößertes Foto ziehen · Doppelklicken zum Zoomen oder Zurücksetzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
