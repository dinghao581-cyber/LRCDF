      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在学习你的调法…"
          }
        }
      }
    },
    "look.saveMine.defaultName" : {
      "comment" : "Name given to an own look when the user typed none.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的风格"
          }
        }
      }
    },
    "look.saveMine.note" : {
      "comment" : "Second line of that card.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照你调好的来"
          }
        }
      }
    },
    "look.saveMine.placeholder" : {
      "comment" : "Placeholder of the name field in the save-my-style dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给它起个名字，例如：我的日系"
          }
        }
      }
    },
    "look.saveMine.text" : {
      "comment" : "Explanation in the save-my-style dialog. Three paragraphs.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先在 Lightroom 里把左边选中的这张照片调到你满意的样子，再回到这里点“保存”。\n之后它会成为一张新的效果卡片，对别的照片也会按你的调法来，并且照样根据每张照片自动调整曝光和白平衡。\n这次带过来的照片里，其他已经调过的也会一起用来学习：调过的越多，学得越准（6 张以上最好）。"
          }
        }
      }
    },
    "page.look" : {
      "comment" : "Tab of the bottom bar in a narrow window: the colour looks. One short word.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "效果"
          }
        }
      }
    },
    "page.more" : {
      "comment" : "Tab of the bottom bar in a narrow window: remaining switches. One short word.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多"
          }
        }
      }
    },
    "paused.note" : {
      "comment" : "Text of the paused card. %1 = photos done, %2 = photos left.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成 %1$lld 张，还剩 %2$lld 张。关掉程序也没关系，下次打开可以接着修。"
          }
        }
      }
    },
    "paused.stop" : {
      "comment" : "Button while paused: keep what is done, give up the rest.",
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到此为止"
          }
