    "rights.remindAtLaunch" : {
      "comment" : "Checkbox at the end of the rights card.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomenout mi tato práva při každém otevření"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei jedem App-Start an diese Rechte erinnern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remind me of these rights every time I open the app"
          }
        },
        "es" : {
          "stringUnit" : {
