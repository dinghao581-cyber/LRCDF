    "break.text" : {
      "comment" : "Banner shown after about 1.5 hours of continuous work.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujete už asi 1,5 hodiny bez přestávky. Vstaňte, trochu se protáhněte a napijte se vody."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie arbeiten seit etwa 1,5 Stunden ohne Pause. Stehen Sie auf, bewegen Sie sich etwas und trinken Sie Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ve been working for about 1.5 hours straight. Stand up, stretch and have some water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas aproximadamente 1,5 horas trabajando sin parar. Levántate, muévete un poco y bebe agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous travaillez depuis environ 1,5 h sans pause. Levez-vous, bougez un peu et buvez de l’eau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah bekerja tanpa jeda sekitar 1,5 jam. Berdirilah, bergerak sebentar, dan minum air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavori da circa 1,5 ore di fila. Alzati, muoviti un po’ e bevi dell’acqua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けて約 1.5 時間作業しています。立ち上がって体を動かし、水分をとりましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 1시간 30분 동안 계속 작업했어요. 잠깐 일어나 몸을 풀고 물을 마셔요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har jobbet i omtrent 1,5 time i strekk. Reis deg, beveg deg litt og drikk vann."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je werkt al ongeveer 1,5 uur achter elkaar. Sta op, beweeg even en drink wat water."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracujesz bez przerwy od około 1,5 godziny. Wstań, poruszaj się chwilę i napij się wody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está trabalhando há cerca de 1,5 hora sem pausa. Levante-se, movimente-se um pouco e beba água."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы работаете без перерыва уже около 1,5 часа. Встаньте, разомнитесь и выпейте воды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har jobbat i ungefär 1,5 timme i sträck. Res dig, rör på dig lite och drick vatten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณทำงานต่อเนื่องมาประมาณ 1.5 ชั่วโมงแล้ว ลุกขึ้นขยับตัวและดื่มน้ำสักหน่อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık 1,5 saattir ara vermeden çalışıyorsunuz. Kalkıp biraz hareket edin ve su için."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã làm việc liên tục khoảng 1,5 giờ. Hãy đứng dậy đi lại một chút và uống nước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已经连续工作约 1.5 小时了，起来活动一下、喝口水吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已連續工作約 1.5 小時。起來活動一下，喝口水吧。"
          }
        }
      }
    },
