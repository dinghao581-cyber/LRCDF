            "value" : "Vern mot gjengjeldelse"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bescherming tegen represailles"
          }
        },
        "pl" : {
          "stringUnit" : {
